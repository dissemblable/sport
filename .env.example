# Base de données PostgreSQL (docker compose up -d)
DATABASE_URL=postgres://sport:sport@localhost:5433/sport

# Base utilisée par les tests d'intégration de l'API
TEST_DATABASE_URL=postgres://sport:sport@localhost:5433/sport_test

# API
API_PORT=3000
API_HOST=127.0.0.1

# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# Frontend : URL de l'API consommée par Vite
VITE_API_URL=http://localhost:3000
