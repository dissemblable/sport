# Copier vers deploy/.env puis `chmod 600 .env`. Jamais versionné.

# Mot de passe PostgreSQL, lu à la première initialisation du volume.
# En hexadécimal : il entre tel quel dans l'URL de connexion de l'API.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Page de déconnexion du portail Authelia (bouton « Se déconnecter » des réglages)
AUTH_LOGOUT_URL=https://auth.valldoy.com/logout
